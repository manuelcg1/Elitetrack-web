<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

  <changeSet author="elitetrack" id="sutran-forwarding-1">
    <addColumn tableName="tc_forward_servers">
      <column name="type" type="VARCHAR(32)" defaultValue="GENERIC_JSON">
        <constraints nullable="false" />
      </column>
      <column name="environment" type="VARCHAR(16)" defaultValue="DEVELOPMENT">
        <constraints nullable="false" />
      </column>
      <column name="connecttimeout" type="INT" defaultValueNumeric="5000">
        <constraints nullable="false" />
      </column>
      <column name="readtimeout" type="INT" defaultValueNumeric="10000">
        <constraints nullable="false" />
      </column>
      <column name="maxattempts" type="INT" defaultValueNumeric="5">
        <constraints nullable="false" />
      </column>
      <column name="retrydelay" type="BIGINT" defaultValueNumeric="1000">
        <constraints nullable="false" />
      </column>
      <column name="transmissionenabled" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false" />
      </column>
    </addColumn>
  </changeSet>

  <changeSet author="elitetrack" id="sutran-forwarding-2">
    <createTable tableName="tc_forward_deliveries">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="positionid" type="BIGINT">
        <constraints nullable="false" />
      </column>
      <column name="serverid" type="BIGINT">
        <constraints nullable="false" />
      </column>
      <column name="status" type="VARCHAR(16)">
        <constraints nullable="false" />
      </column>
      <column name="payload" type="VARCHAR(2048)">
        <constraints nullable="false" />
      </column>
      <column name="attempts" type="INT" defaultValueNumeric="0">
        <constraints nullable="false" />
      </column>
      <column name="nextattempt" type="TIMESTAMP" />
      <column name="httpstatus" type="INT" />
      <column name="responsecode" type="INT" />
      <column name="crc" type="VARCHAR(6)" />
      <column name="errormessage" type="VARCHAR(512)" />
      <column name="createdtime" type="TIMESTAMP">
        <constraints nullable="false" />
      </column>
      <column name="senttime" type="TIMESTAMP" />
      <column name="updatedtime" type="TIMESTAMP">
        <constraints nullable="false" />
      </column>
    </createTable>

    <addUniqueConstraint
      tableName="tc_forward_deliveries"
      columnNames="positionid, serverid"
      constraintName="uk_forward_delivery_position_server" />

    <addForeignKeyConstraint
      baseTableName="tc_forward_deliveries"
      baseColumnNames="serverid"
      constraintName="fk_forward_delivery_serverid"
      referencedTableName="tc_forward_servers"
      referencedColumnNames="id"
      onDelete="CASCADE" />

    <createIndex tableName="tc_forward_deliveries" indexName="idx_forward_delivery_pending">
      <column name="status" />
      <column name="nextattempt" />
    </createIndex>
    <createIndex tableName="tc_forward_deliveries" indexName="idx_forward_delivery_server">
      <column name="serverid" />
      <column name="createdtime" />
    </createIndex>
  </changeSet>

</databaseChangeLog>
